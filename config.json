  "lambda_1": 1.0,
  "lambda_2": 1.0,
  "ot": {
    "epsilon": 0.1,
    "tau": 1.0,
    "temperature": 1.0,
    "max_iterations": 500,
    "tolerance": 1e-07,
    "warmup_epochs": 20,
    "ramp_epochs": 20,
    "prior_smoothing": 0.001
  },
  "save_model": true,
  "result_path": "results"
}
